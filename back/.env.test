DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=player_market_test
DATABASE_USER=postgres
DATABASE_PASSWORD=root
NODE_ENV=test

REDIS_HOST=localhost
REDIS_PORT=6379
PLAYERS_CACHE_TTL_SECONDS=60

FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_RATE_LIMIT_PER_MINUTE=10

WHO_SCORED_BASE_URL=https://www.whoscored.com
WHO_SCORED_MIN_DELAY_MS=0
WHO_SCORED_MATCH_THRESHOLD=0.85
WHO_SCORED_MAX_CONSECUTIVE_FAILURES=5

# --- 05-auth (FR-014, research #7 y #9) ---
JWT_SECRET=cambiar-esto-en-cada-entorno-secreto-largo-y-aleatorio-test
JWT_EXPIRATION=2h
ADMIN_API_KEY=cambiar-esto-clave-administrativa-test
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=5
CORS_ALLOWED_ORIGINS=http://localhost:5173

# TheSportsDB (imágenes cartoon de jugadores). "123" es la clave pública de prueba del plan gratis.
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_API_KEY=123
THESPORTSDB_RATE_LIMIT_PER_MINUTE=30
THESPORTSDB_MATCH_THRESHOLD=0.85
THESPORTSDB_RETRY_AFTER_DAYS=30

# --- 07-cotizacion (research #1): sin cron en tests ---
QUOTES_SCHEDULER_ENABLED=false
QUOTES_RECALC_CRON=0 3 * * 1
QUOTES_RECALC_TIMEZONE=
